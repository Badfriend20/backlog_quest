{
  "name": "backlog-quest",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "generate:examples": "node scripts/generate-example-backlogs.mjs",
    "check:text": "node scripts/check-text-encoding.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:pages": "node scripts/check-pages-deployment.mjs",
    "validate": "npm run format:check && npm run lint && npm run check:text && npm run test && npm run check:architecture && npm run build && npm run check:pages",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "filelist": "2.0.2",
    "jake": "12.10.1",
    "serialize-javascript": "7.0.7",
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  }
}
